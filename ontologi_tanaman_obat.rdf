        <memilikiHabitus rdf:resource="http://www.semanticweb.org/tanamanobat#H_Pohon"/>
        <memilikiJenisDaun rdf:resource="http://www.semanticweb.org/tanamanobat#JD_Tunggal"/>
        <memilikiPangkalDaun rdf:resource="http://www.semanticweb.org/tanamanobat#PK_Membulat"/>
        <memilikiPangkalDaun rdf:resource="http://www.semanticweb.org/tanamanobat#PK_Runcing"/>
        <memilikiPangkalDaun rdf:resource="http://www.semanticweb.org/tanamanobat#PK_Tumpul"/>
        <memilikiPermukaanDaun rdf:resource="http://www.semanticweb.org/tanamanobat#PM_Berbulu"/>
        <memilikiTakson rdf:resource="http://www.semanticweb.org/tanamanobat#T_Litsea"/>
        <memilikiTepiDaun rdf:resource="http://www.semanticweb.org/tanamanobat#TD_Rata"/>
        <memilikiTulangDaun rdf:resource="http://www.semanticweb.org/tanamanobat#TL_Menyirip"/>
        <memilikiUjungDaun rdf:resource="http://www.semanticweb.org/tanamanobat#UD_Membulat"/>
        <memilikiUjungDaun rdf:resource="http://www.semanticweb.org/tanamanobat#UD_Tumpul"/>
        <memilikiWarnaDaun rdf:resource="http://www.semanticweb.org/tanamanobat#WD_Hijau"/>
        <namaAsing>Bollygum</namaAsing>
        <namaIndonesia>Adem Ati</namaIndonesia>
        <namaLatin>Litsea glutinosa (Lour.) C.B.Rob.</namaLatin>
        <rdfs:label>Adem Ati</rdfs:label>
    </owl:NamedIndividual>
    


