    <!-- http://www.semanticweb.org/tanamanobat#Adem_Ati -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/tanamanobat#Adem_Ati">
        <rdf:type rdf:resource="http://www.semanticweb.org/tanamanobat#Tanaman_Obat"/>
        <memilikiBagian rdf:resource="http://www.semanticweb.org/tanamanobat#Adem_Ati_Daun"/>
        <memilikiBagian rdf:resource="http://www.semanticweb.org/tanamanobat#Adem_Ati_Kulit_Batang"/>
