    :memilikiPermukaanDaun :PM_Berbulu,
        :PM_Licin ;
    :memilikiTakson :T_Annona ;
    :memilikiTepiDaun :TD_Rata ;
    :memilikiTulangDaun :TL_Menyirip ;
    :memilikiUjungDaun :UD_Meruncing ;
    :memilikiWarnaDaun :WD_Hijau_tua ;
    :namaAsing "Sugar apple" ;
    :namaIndonesia "Srikaya" ;
    :namaLatin "Annona squamosa L." .

:Tembelekan a :Tanaman_Obat,
        owl:NamedIndividual ;
    rdfs:label "Tembelekan" ;
    :farmakologi "Ekstrak air daun dosis 300 dan 500 mg/kg BB p.o menunjukkan efek analgesik 22,38% dan 24,82% serta antiinflamasi 54,38% dan 61,40% (Gidwani dkk., 2009)." ;
    :memilikiBagian :Tembelekan_Akar,
        :Tembelekan_Bunga,
        :Tembelekan_Daun,
        :Tembelekan_Herba ;
    :memilikiBentukDaun :BD_Bulat_telur,
