:Srikaya a :Tanaman_Obat,
        owl:NamedIndividual ;
    rdfs:label "Srikaya" ;
    :farmakologi "Ekstrak etanol biji terhadap Shigella dysenteriae, konsentrasi 15% menghambat 6,9 mm (Rianto dkk., 2015). Ekstrak metanol kulit batang 50 mg/kg BB p.o menurunkan udema tikus (Singh dkk., 2014)." ;
    :memilikiBagian :Srikaya_Akar,
        :Srikaya_Batang,
        :Srikaya_Biji,
        :Srikaya_Buah,
