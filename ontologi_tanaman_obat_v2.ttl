:Bungur a :Tanaman_Obat,
        owl:NamedIndividual ;
    rdfs:label "Bungur" ;
    :farmakologi "Ekstrak etanol 80% daun (terstandar 1% asam korosolik) dosis 32 dan 48 mg/orang selama 2 minggu menurunkan kadar glukosa darah hingga 30% (Judy dkk., 2003)." ;
    :memilikiBagian :Bungur_Biji,
        :Bungur_Daun,
        :Bungur_Kulit_Batang ;
    :memilikiBentukDaun :BD_Bulat_telur,
