    :memilikiTepiDaun :TD_Rata ;
    :memilikiUjungDaun :UD_Runcing ;
    :memilikiWarnaDaun :WD_Hijau ;
    :namaAsing "Orosne" ;
    :namaIndonesia "Balsem" ;
    :namaLatin "Polygala paniculata L." .

:Belimbing_Buah a :Tanaman_Obat,
        owl:NamedIndividual ;
    rdfs:label "Belimbing Buah" ;
    :farmakologi "Jus buah dosis 100% dan 50% sebanyak 200 mL pada 90 subyek menurunkan tekanan darah sistolik signifikan setelah 30 menit, tanpa penurunan signifikan pada diastolik (Wijaya dkk., 2012)." ;
    :memilikiBagian :Belimbing_Buah_Akar,
        :Belimbing_Buah_Batang,
        :Belimbing_Buah_Buah,
        :Belimbing_Buah_Daun ;
    :memilikiBentukDaun :BD_Bulat_telur,
        :BD_Elips ;
    :memilikiHabitus :H_Pohon ;
    :memilikiJenisDaun :JD_Majemuk ;
    :memilikiPangkalDaun :PK_Membulat ;
    :memilikiPermukaanDaun :PM_Gundul ;
    :memilikiTakson :T_Averrhoa ;
    :memilikiTepiDaun :TD_Rata ;
    :memilikiTulangDaun :TL_Menyirip ;
    :memilikiUjungDaun :UD_Meruncing,
        :UD_Runcing ;
    :memilikiWarnaDaun :WD_Hijau_muda,
        :WD_Hijau_tua ;
    :namaAsing "Star fruit" ;
    :namaIndonesia "Belimbing Buah" ;
    :namaLatin "Averrhoa carambola L." .

