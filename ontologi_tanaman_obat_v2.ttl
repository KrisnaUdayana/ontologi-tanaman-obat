        :UD_Tumpul ;
    :memilikiWarnaDaun :WD_Hijau_tua ;
    :namaAsing "Queen's crepe-myrtle" ;
    :namaIndonesia "Bungur" ;
    :namaLatin "Lagerstroemia speciosa (L.) Pers." .

