    :memilikiTakson :T_Boesenbergia ;
    :memilikiTepiDaun :TD_Rata ;
    :memilikiTulangDaun :TL_Menyirip ;
    :memilikiUjungDaun :UD_Runcing ;
    :memilikiWarnaDaun :WD_Hijau_muda,
        :WD_Hijau_tua ;
    :namaAsing "Chinese keys" ;
    :namaIndonesia "Temu Kunci" ;
    :namaLatin "Boesenbergia rotunda (L.) Mansf." .

:Tepus a :Tanaman_Obat,
        owl:NamedIndividual ;
    rdfs:label "Tepus" ;
    :farmakologi "Ekstrak metanol, diklorometan, dan etil asetat daun menunjukkan aktivitas penghambatan bakteri S. aureus, S. epidermidis, B. subtilis, B. cereus, E. faecalis, S. pneumonia dengan MIC 0,016-0,063 mg/mL (Daniel-Jambun dkk., 2017)." ;
    :memilikiBagian :Tepus_Batang,
        :Tepus_Bunga,
        :Tepus_Daun,
        :Tepus_Rimpang ;
