:Akar_Wangi a :Tanaman_Obat,
        owl:NamedIndividual ;
    rdfs:label "Akar Wangi" ;
    :farmakologi "Ekstrak etanol akar dosis 50, 100, 200 mg/kg BB p.o menurunkan respon nyeri 66%, 80%, 87% pada tikus. Pada uji antiinflamasi, menghambat udema 65%, 76%, 87% (Elizabeth dkk., 2012)." ;
    :memilikiBagian :Akar_Wangi_Akar,
        :Akar_Wangi_Daun ;
    :memilikiBentukDaun :BD_Memanjang ;
    :memilikiHabitus :H_Terna ;
    :memilikiJenisDaun :JD_Tunggal ;
    :memilikiPangkalDaun :PK_Membulat,
        :PK_Tumpul ;
    :memilikiPermukaanDaun :PM_Gundul,
        :PM_Kasap ;
    :memilikiTakson :T_Chrysopogon ;
    :memilikiTepiDaun :TD_Rata ;
    :memilikiTulangDaun :TL_Sejajar ;
    :memilikiUjungDaun :UD_Runcing ;
    :memilikiWarnaDaun :WD_Hijau ;
    :namaAsing "Vetiver" ;
    :namaIndonesia "Akar Wangi" ;
    :namaLatin "Chrysopogon zizanioides (L.) Roberty" .

