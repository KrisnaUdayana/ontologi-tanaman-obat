        owl:NamedIndividual ;
    rdfs:label "Jaring Emas" ;
    :farmakologi "Ekstrak metanol dan kloroform akar yang diuji dengan brine shrimp lethality test tidak bersifat toksik karena nilai LD50 masing-masing lebih besar dari 1.000 ppm (Rakhmawati dkk., 1993)." ;
