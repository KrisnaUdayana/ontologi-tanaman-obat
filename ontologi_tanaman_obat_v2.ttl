:Balsem a :Tanaman_Obat,
        owl:NamedIndividual ;
    rdfs:label "Balsem" ;
    :farmakologi "Ekstrak hidroalkohol daun dosis 0,001-10 mg/kg BB menunjukkan efek analgesik pada beberapa model nyeri pada mencit; efektivitas lebih tinggi pada fase nyeri inflamasi akibat formalin (Lapa dkk., 2009)." ;
    :memilikiBagian :Balsem_Akar,
        :Balsem_Herba ;
    :memilikiBentukDaun :BD_Lanset,
        :BD_Lanset_memanjang ;
    :memilikiHabitus :H_Terna ;
