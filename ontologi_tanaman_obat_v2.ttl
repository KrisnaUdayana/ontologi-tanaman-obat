    :namaLatin "Cyphomandra betacea Sendtn." .

:Tikusan a :Tanaman_Obat,
        owl:NamedIndividual ;
    rdfs:label "Tikusan" ;
    :farmakologi "Ekstrak metanol daun dosis 50, 100, 200 mg/mL menunjukkan penutupan luka 95,7%, 97,4%, 98,8% pada hari ke 15, lebih baik dari standar intrasite gel 95,0% dan kontrol gom akasia 78,9% (Albaayit dkk., 2015)." ;
