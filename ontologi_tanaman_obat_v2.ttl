    :memilikiWarnaDaun :WD_Cokelat_kemerahan,
        :WD_Hijau_tua ;
    :namaIndonesia "Tepus" ;
    :namaLatin "Etlingera coccinea (Blume) S.Sakai & Nagam." .

:Terong_Mandras a :Tanaman_Obat,
        owl:NamedIndividual ;
    rdfs:label "Terong Mandras" ;
    :farmakologi "Ekstrak kering buah dosis 200 dan 300 mg/kg BB p.o selama 7 minggu pada tikus obesitas menurunkan berat badan, glukosa darah, trigliserida, dan LDL-c (Abdul Kadir dkk., 2015)." ;
    :memilikiBagian :Terong_Mandras_Buah ;
