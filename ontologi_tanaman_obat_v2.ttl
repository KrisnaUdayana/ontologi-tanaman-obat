    :memilikiHabitus :H_Semak ;
    :memilikiJenisDaun :JD_Tunggal ;
    :memilikiPangkalDaun :PK_Runcing ;
    :memilikiPermukaanDaun :PM_Berbulu ;
    :memilikiTakson :T_Lantana ;
    :memilikiTepiDaun :TD_Bergerigi ;
    :memilikiTulangDaun :TL_Menyirip ;
    :memilikiUjungDaun :UD_Runcing ;
    :memilikiWarnaDaun :WD_Hijau,
        :WD_Hijau_tua ;
    :namaAsing "Lantana" ;
    :namaIndonesia "Tembelekan" ;
    :namaLatin "Lantana camara L." .

:Temu_Kunci a :Tanaman_Obat,
        owl:NamedIndividual ;
    rdfs:label "Temu Kunci" ;
    :farmakologi "Ekstrak etanol rimpang dosis 200 mg/kg BB p.o selama 8 minggu pada mencit berpakan tinggi lemak menurunkan berat badan dan ketebalan massa lemak, serta menghambat kenaikan kolesterol total, LDL, dan trigliserida serum (Kim dkk., 2012)." ;
    :memilikiBagian :Temu_Kunci_Daun,
        :Temu_Kunci_Rimpang ;
    :memilikiBentukDaun :BD_Bulat_telur_memanjang,
